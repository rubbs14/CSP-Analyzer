<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CspAnalyzer.Desktop.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:lvcm="using:LiveChartsCore.Measure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="CspAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CSP Analyzer"
        Width="1400" Height="820" MinWidth="1000" MinHeight="650">

    <!--
    Layout shell from S7 (see the wireframe survey in docs/superpowers/
    SESSIONS.md history / session memory), with S8's dataset-loading
    bindings (File I/O buttons, import range/threshold, reference/dataset
    status), S9's run flow (Run CSP / Cancel, indeterminate progress bar -
    the python backend has no incremental progress protocol, so this is a
    single blocking-call spinner, not a percentage), and S10b's embedded
    charts + player navigation + manual-override workflow. The separate
    results table/pie-chart window (ResultsWindow) is S10.
    -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <!-- Outer: fixed-width sidebar (Form1's tableLayoutPanel1, ~204px) + fill content (tableLayoutPanel2) -->
    <Grid ColumnDefinitions="210,*">

        <!-- Sidebar: panel1 / panel4 / panel3 / panel13 -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto,Auto">
            <Border Grid.Row="0" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="File I/O" />
                    <Button Content="Load Reference" Command="{Binding LoadReferenceCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
                    <Button Content="Load Dataset" Command="{Binding LoadDatasetCommand}" IsEnabled="{Binding IsReferenceLoaded}" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="section">
                <StackPanel Spacing="2">
                    <TextBlock Classes="sectionHeader" Text="Import Controls / Run" />
                    <Grid ColumnDefinitions="30,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="NMin" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding NMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="NMax" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NMax}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="HMin" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HMin}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HMax" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HMax}" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="RefI" VerticalAlignment="Center" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReferenceIntensityThreshold}" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="DSI" VerticalAlignment="Center" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DatasetIntensityThreshold}" />
                    </Grid>
                    <TextBlock Text="{Binding TotalSubfoldersFound, StringFormat='Subfolders scanned: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding PeaklistFilesFoundCount, StringFormat='Peaklist files found: {0}'}" FontSize="11" />
                    <Button Content="Run CSP" Command="{Binding RunCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <Button Content="Cancel" Command="{Binding CancelRunCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="Run Info" />
                    <TextBlock Text="{Binding ReferenceStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatasetStatusText}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Height="6" Margin="0,4" />
                    <TextBlock Text="{Binding RunStatusText}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="section">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                    <Button Content="Help" />
                    <Button Content="Details" />
                    <Button Content="Shortcuts" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Content: chart zone (tableLayoutPanel3) + bottom bar (tableLayoutPanel6) -->
        <Grid Grid.Column="1" RowDefinitions="*,130">

            <!-- Chart zone: left stacked bar charts + right spectra overlay -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Grid Grid.Column="0" RowDefinitions="*,*">
                    <Border Grid.Row="0" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Peaks Difference Distribution" />
                            <lvc:CartesianChart x:Name="PeakDiffChart"
                                                 Series="{Binding PeakDiffSeries}"
                                                 XAxes="{Binding PeakDiffXAxes}"
                                                 YAxes="{Binding PeakDiffYAxes}"
                                                 Sections="{Binding PeakDiffSections}"
                                                 VisualElements="{Binding PeakDiffAnnotations}"
                                                 ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Probability Distribution" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="4,0">
                                <TextBlock Text="Decision Threshold:" VerticalAlignment="Center" FontSize="11" />
                                <Slider Width="160" Minimum="0" Maximum="1" TickFrequency="0.01"
                                        Value="{Binding ManualProbabilityThreshold}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ManualProbabilityThreshold, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <lvc:CartesianChart x:Name="ProbabilityChart"
                                                 Series="{Binding ProbabilitySeries}"
                                                 XAxes="{Binding ProbabilityXAxes}"
                                                 YAxes="{Binding ProbabilityYAxes}"
                                                 Sections="{Binding ProbabilitySections}"
                                                 VisualElements="{Binding ProbabilityAnnotations}"
                                                 ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Classes="section">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Spectra Overlay" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,4,0,0">
                            <Button Content="Reset Zoom" Command="{Binding ResetOverlayZoomCommand}" />
                            <Button Content="Fit to Reference" Command="{Binding FitOverlayZoomToReferenceCommand}" />
                        </StackPanel>
                        <lvc:CartesianChart Series="{Binding OverlaySeries}" XAxes="{Binding OverlayXAxes}" YAxes="{Binding OverlayYAxes}" ZoomMode="{x:Static lvcm:ZoomAndPanMode.Both}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottom bar: stats/results strip + experiment-navigation console -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*">

                <Grid Grid.Column="0" ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Analysis Info" />
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding ReferencePeakCount, StringFormat='Ref peaks: {0}'}" FontSize="11" />
                                <TextBlock Text="{Binding ReferenceMinIntensity, StringFormat='Ref min int: {0:F0}'}" FontSize="11" />
                                <TextBlock Text="{Binding ReferenceMaxIntensity, StringFormat='Ref max int: {0:F0}'}" FontSize="11" />
                                <TextBlock Text="{Binding DatasetSpectra.Count, StringFormat='Experiments loaded: {0}'}" FontSize="11" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Automated Analysis Results" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <CheckBox Content="Actives" IsChecked="{Binding IsActivesFilterChecked}" />
                                <CheckBox Content="Inactives" IsChecked="{Binding IsInactivesFilterChecked}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*">
                                <lvc:PieChart Grid.Column="0" Series="{Binding ActivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}" />
                                <lvc:PieChart Grid.Column="1" Series="{Binding InactivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Manual Analysis Results" />
                            <Button DockPanel.Dock="Bottom" Content="Reset All Man. Flags" Command="{Binding ResetAllManualFlagsCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            <lvc:CartesianChart Series="{Binding ManualResultsSeries}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Current Experiment:" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentExperimentNumber}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentCounterText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Go To Experiment:" VerticalAlignment="Center" />
                            <TextBox Width="60" Text="{Binding GoToExperimentText}" />
                            <Button Content="Go" Command="{Binding GoToExperimentCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,*">
                        <Grid Grid.Column="0" ColumnDefinitions="*,*,*,*" Margin="4">
                            <Button Grid.Column="0" Content="|&lt;" Command="{Binding FirstCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="&lt;" Command="{Binding PreviousCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="&gt;" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Content="&gt;|" Command="{Binding LastCommand}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4" Spacing="2">
                            <TextBlock Text="{Binding CurrentManualStatusText}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentAutomaticStatusText}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentPeakDifference, StringFormat='ΔPeaks: {0}'}" FontSize="10" />
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <Button Content="Mark Active" Command="{Binding MarkActiveCommand}" />
                                <Button Content="Mark Inactive" Command="{Binding MarkInactiveCommand}" />
                                <Button Content="Reset" Command="{Binding ResetManualStatusCommand}" />
                            </StackPanel>
                            <Button Content="Export" Command="{Binding OpenResultsWindowCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
