<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CspAnalyzer.Desktop.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:lvcm="using:LiveChartsCore.Measure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="CspAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/cspanalyzer_SPd_icon.ico"
        Title="CSP Analyzer"
        Width="1400" Height="820" MinWidth="1000" MinHeight="650">

    <!--
    Layout shell from S7 (see the wireframe survey in docs/superpowers/
    SESSIONS.md history / session memory), with S8's dataset-loading
    bindings (File I/O buttons, import range/threshold, reference/dataset
    status), S9's run flow (Run CSP / Cancel, indeterminate progress bar -
    the python backend has no incremental progress protocol, so this is a
    single blocking-call spinner, not a percentage), and S10b's embedded
    charts + player navigation + manual-override workflow. The separate
    results table/pie-chart window (ResultsWindow) is S10.
    -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
        Button styling (S12 visual pass): a shared rounded/shadow/hover
        base applied to every Button, plus a small set of semantic
        Classes= variants layered on top so primary actions (Run CSP,
        Load Reference/Dataset, Go, Export, Mark as Active) read as more
        important than secondary/utility ones (Reset to Default, theme
        toggles, nav arrows) at a glance:

          - Classes="accent"  : filled blue/indigo gradient - primary CTA.
          - Classes="success" : filled green gradient - "Mark as Active"
            (replaces the old flat Background="LightGreen").
          - Classes="danger"  : filled rose/red gradient - "Mark as
            Inactive" (replaces flat Background="LightPink") and Cancel
            (interrupts a running analysis - same "stop" language).
          - Classes="compact" : tighter padding/font for buttons that sit
            in cramped rows (About/Shortcuts/Help, Light/Dark/System, the
            |</</>/>| nav strip, Ref/Exp PP Details) so the rounder/
            padded look doesn't wrap or overflow those narrow containers.
          - Classes="swatch"  : the 5 tiny 20x20 background-colour picker
            buttons - keeps their flat colour fill (set locally per
            button and thus untouched by these Setters), just adds a
            circular shape and a hover/press ring instead of turning
            them into gradient pill buttons.

        No Command=/Click=/Content= bindings are touched by any of this -
        only Classes= plus, on the two Mark as Active/Inactive buttons,
        removal of the old inline Background (now supplied by the
        success/danger classes as a gradient instead of a flat fill).
        -->
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.1" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button:pressed">
            <Setter Property="Opacity" Value="0.82" />
        </Style>
        <Style Selector="Button:disabled">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!-- Primary/accent: Run CSP, Load Reference/Dataset, Go, Export -->
        <Style Selector="Button.accent">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2C4BC7" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#4E7DF0" Offset="0" />
                    <GradientStop Color="#2C4BC7" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="BorderBrush" Value="#3A5CDC" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#6493F5" Offset="0" />
                    <GradientStop Color="#3A5CDC" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.accent:pressed">
            <Setter Property="Background" Value="#28409E" />
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Background" Value="#5A6B99" />
            <Setter Property="Foreground" Value="#DDE3F5" />
        </Style>

        <!-- Success/active: "Mark as Active" -->
        <Style Selector="Button.success">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#1E7A3D" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#57C06B" Offset="0" />
                    <GradientStop Color="#1E7A3D" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.success:pointerover">
            <Setter Property="BorderBrush" Value="#28994C" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#6BD37E" Offset="0" />
                    <GradientStop Color="#28994C" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.success:pressed">
            <Setter Property="Background" Value="#186633" />
        </Style>
        <Style Selector="Button.success:disabled">
            <Setter Property="Background" Value="#6E9B7A" />
            <Setter Property="Foreground" Value="#E3F3E7" />
        </Style>

        <!-- Danger/stop: "Mark as Inactive" and Cancel (interrupts a run) -->
        <Style Selector="Button.danger">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#B72336" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#E8576B" Offset="0" />
                    <GradientStop Color="#B72336" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="BorderBrush" Value="#C93347" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#F06D80" Offset="0" />
                    <GradientStop Color="#C93347" Offset="1" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Button.danger:pressed">
            <Setter Property="Background" Value="#8F1B29" />
        </Style>
        <Style Selector="Button.danger:disabled">
            <Setter Property="Background" Value="#B08A8F" />
            <Setter Property="Foreground" Value="#F5E3E5" />
        </Style>

        <!-- Compact: tight rows that must not wrap/overflow their container -->
        <Style Selector="Button.compact">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>

        <!-- Field: numeric inputs in the 210px Options panel - FluentTheme's
             default TextBox MinWidth is wider than the Import
             Control/Peak Filtering grid columns can offer, so it was
             pushing the boxes past the panel border instead of shrinking. -->
        <Style Selector="TextBox.field">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Swatch: the 20x20 flat-colour background pickers - circular hover/press ring only -->
        <Style Selector="Button.swatch">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
        </Style>
        <Style Selector="Button.swatch:pressed">
            <Setter Property="BorderBrush" Value="#4E7DF0" />
            <Setter Property="Opacity" Value="1" />
        </Style>

        <!-- Player: First/Previous/Next/Last spectrum navigation - icon over
             label, flat, teal when enabled, dimmed (not FluentTheme's default
             disabled foreground swap, which an Image ignores) when not. -->
        <Style Selector="Button.player">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,4" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.player:pointerover">
            <Setter Property="Background" Value="#1F00A297" />
        </Style>
        <Style Selector="Button.player:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenShortcutsWindowCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+R" Command="{Binding ShowReferencePpDetailsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+E" Command="{Binding ShowExperimentPpDetailsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+I" Command="{Binding ResetImportControlsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+T" Command="{Binding ResetPeakFilteringCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+O" Command="{Binding ResetAllImportAndThresholdControlsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+Space" Command="{Binding ResetAllZoomCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+F" Command="{Binding ShowCorruptedPeaklistExpCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+Y" Command="{Binding ShowOutOfImportRangeExpCommand}" />
    </Window.KeyBindings>
    <!--
    Bindings NOT declared above, added programmatically in the
    constructor instead:

    - Ctrl+Q (CloseCommand) and G (FocusGoToExperimentCommand): KeyBinding
      is a plain AvaloniaObject, not part of the visual/name-scope tree,
      so neither {Binding ..., RelativeSource={RelativeSource Self}} nor
      an ElementName/#name binding to a MainWindow-owned property
      resolves (both silently yield a null Command in Avalonia 11.2.3) -
      confirmed empirically, not assumed. Setting Command directly on a
      code-constructed KeyBinding sidesteps the binding system entirely.

    - R, N, D, S, A, T, I, Enter, and the arrow keys (Right/Left/Down/Up): these
      bare-key gestures collide with normal text entry and caret
      movement (e.g. typing "active" into GoToExperimentText types a
      bare "a"; pressing Right to move the caret in any focused
      TextBox). A plain {Binding XCommand} KeyBinding intercepts the key
      on KeyDown *before* the focused TextBox ever gets to insert the
      character or move the caret (confirmed empirically via
      KeyboardDevice.ProcessRawEvent: KeyBindings are matched by walking
      up from the focused element before the routed KeyDown event is
      even raised, so TextBox's own handling never runs once a binding's
      command reports CanExecute==true). Wrapping each in a command whose
      CanExecute additionally requires "no TextBox is currently focused"
      leaves CanExecute false while typing/editing, so the KeyBinding
      doesn't set Handled and the key falls through to the focused
      TextBox normally.

    - Ctrl+C (ResetBarChartZoomCommand), Ctrl+Y (ResetOverlayZoomCommand),
      Ctrl+X (FitOverlayZoomToReferenceCommand), and Ctrl+R
      (ResetApplicationCommand): same defect class as the bare
      keys/arrows above, just via a Ctrl+letter combo. Window.KeyBindings
      intercept before a routed KeyDown reaches a focused control, so a
      plain {Binding ...} KeyBinding on these would always fire the
      chart-reset commands instead of letting a focused TextBox perform its
      standard clipboard copy (Ctrl+C) / cut (Ctrl+X) / redo (Ctrl+Y), even
      with text selected. Guarded the same way, via GuardedViewModelCommand.
      (S11c originally bound Ctrl+C to ResetOverlayZoomCommand instead of
      ResetBarChartZoomCommand and left Ctrl+Y unbound - legacy CSPv2/
      Form1.cs:2986-3002 has it the other way around; fixed in S12.)

    - Ctrl+A (ToggleAutoActivesFilterCommand) and Ctrl+I
      (ToggleAutoInactivesFilterCommand): same defect class again - Ctrl+A is
      "select all" and Ctrl+I is commonly "italic" in standard text editing;
      both must not fire while a TextBox is focused. Guarded via
      GuardedViewModelCommand.
    -->

    <!-- Outer: fixed-width sidebar (Form1's tableLayoutPanel1, ~204px) + fill content (tableLayoutPanel2) -->
    <Grid ColumnDefinitions="210,*">

        <!-- Sidebar: panel1 / panel4 / panel3 / panel13 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Border Grid.Row="0" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="File I/O" />
                    <Button Content="Load Reference" Command="{Binding LoadReferenceCommand}" Classes="accent" HorizontalAlignment="Stretch" Margin="0,2" />
                    <Button Content="Load Dataset" Command="{Binding LoadDatasetCommand}" IsEnabled="{Binding IsReferenceLoaded}" Classes="accent" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="section">
                <StackPanel Spacing="1">
                    <TextBlock Classes="sectionHeader" Text="DS Info" />
                    <TextBlock Text="{Binding TotalSubfoldersFound, StringFormat='Exp Subfolders: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding ValidXmlPeaklistCount, StringFormat='Valid XML PeakList: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding CorruptedXmlPeaklistCount, StringFormat='Corrupted XML PeakList: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding OutOfPeakImportRangeCount, StringFormat='Out of Peak Import Range: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding ValidExperimentsCount, StringFormat='Valid Experiments: {0}'}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="section">
                <StackPanel Spacing="2">
                    <TextBlock Classes="sectionHeader" Text="Options" />

                    <TextBlock Text="Import Control" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="Auto,*,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Min" FontStyle="Italic" FontSize="10" HorizontalAlignment="Center" Margin="2" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Max" FontStyle="Italic" FontSize="10" HorizontalAlignment="Center" Margin="2" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="15N (ppm)" FontStyle="Italic" VerticalAlignment="Center" Margin="2" />
                        <TextBox x:Name="NMinTextBox" Classes="field" Grid.Row="1" Grid.Column="1" Text="{Binding NMin}" HorizontalContentAlignment="Center" Margin="2" />
                        <TextBox Classes="field" Grid.Row="1" Grid.Column="2" Text="{Binding NMax}" HorizontalContentAlignment="Center" Margin="2" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="1H (ppm)" FontStyle="Italic" VerticalAlignment="Center" Margin="2" />
                        <TextBox Classes="field" Grid.Row="2" Grid.Column="1" Text="{Binding HMin}" HorizontalContentAlignment="Center" Margin="2" />
                        <TextBox Classes="field" Grid.Row="2" Grid.Column="2" Text="{Binding HMax}" HorizontalContentAlignment="Center" Margin="2" />
                    </Grid>
                    <Button Content="Reset to Default" Command="{Binding ResetImportControlsCommand}" Classes="compact" HorizontalAlignment="Stretch" Margin="0,2" />

                    <TextBlock Text="Peak Filtering" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Lowest Intensity threshold" FontStyle="Italic" FontSize="10" HorizontalAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <TextBox Classes="field" Grid.Row="0" Grid.Column="0" Text="{Binding ReferenceIntensityThreshold}" HorizontalContentAlignment="Center" Margin="2" />
                        <TextBox Classes="field" Grid.Row="0" Grid.Column="1" Text="{Binding DatasetIntensityThreshold}" HorizontalContentAlignment="Center" Margin="2" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Reference" HorizontalAlignment="Center" Margin="2" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Dataset" HorizontalAlignment="Center" Margin="2" />
                    </Grid>
                    <Button Content="Reset to Default" Command="{Binding ResetPeakFilteringCommand}" Classes="compact" HorizontalAlignment="Stretch" Margin="0,2" />

                    <TextBlock Text="{Binding TotalSubfoldersFound, StringFormat='Subfolders scanned: {0}'}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PeaklistFilesFoundCount, StringFormat='Peaklist files found: {0}'}" FontSize="11" />
                    <Button Content="Run CSP" Command="{Binding RunCommand}" Classes="accent" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <Button Content="Cancel" Command="{Binding CancelRunCommand}" Classes="danger" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="Run Info" />
                    <TextBlock Text="{Binding ReferenceStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatasetStatusText}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Height="6" Margin="0,4" />
                    <Border IsVisible="{Binding RunCompletedSuccessfully}" Background="Green" CornerRadius="3" Margin="0,4" Padding="0,3">
                        <TextBlock Text="Analysis complete" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding RunStatusText}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Classes="section">
                <StackPanel Spacing="4">
                    <Button Content="Save MCC Stats" Command="{Binding SaveMccStatsCommand}" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Content="About" Command="{Binding OpenAboutWindowCommand}" Classes="compact" />
                        <Button Content="Shortcuts" Command="{Binding OpenShortcutsWindowCommand}" Classes="compact" />
                        <Button Content="Help" Command="{Binding OpenHelpWindowCommand}" Classes="compact" />
                    </StackPanel>
                    <TextBlock Text="Developed by R. Byrne and R. Fino" FontSize="9" FontStyle="Italic"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Classes="section">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionHeader" Text="Appearance" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Content="Light" Click="OnThemeLightClick" Classes="compact" />
                        <Button Content="Dark" Click="OnThemeDarkClick" Classes="compact" />
                        <Button Content="System" Click="OnThemeSystemClick" Classes="compact" />
                    </StackPanel>
                    <TextBlock Text="Background Color" FontSize="10" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Width="20" Height="20" Padding="0" Background="#1E1E2E" Click="OnBackgroundColorClick" Tag="#1E1E2E" Classes="swatch" />
                        <Button Width="20" Height="20" Padding="0" Background="#F5F5F5" Click="OnBackgroundColorClick" Tag="#F5F5F5" Classes="swatch" />
                        <Button Width="20" Height="20" Padding="0" Background="#1B2A38" Click="OnBackgroundColorClick" Tag="#1B2A38" Classes="swatch" />
                        <Button Width="20" Height="20" Padding="0" Background="#1F2E24" Click="OnBackgroundColorClick" Tag="#1F2E24" Classes="swatch" />
                        <Button Width="20" Height="20" Padding="0" Background="#2E1F2A" Click="OnBackgroundColorClick" Tag="#2E1F2A" Classes="swatch" />
                        <Button Content="Reset" FontSize="10" Click="OnBackgroundColorResetClick" Classes="compact" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Content: chart zone (tableLayoutPanel3) + bottom bar (tableLayoutPanel6) -->
        <Grid Grid.Column="1" RowDefinitions="*,165">

            <!-- Chart zone: left stacked bar charts + right spectra overlay -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,*,*">
                    <TextBlock Grid.Row="0" Text="MST Distance fingerprint" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,2,0,4" />
                    <Border Grid.Row="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Peaks Difference Distribution" />
                            <Grid>
                                <lvc:CartesianChart x:Name="PeakDiffChart"
                                                     Series="{Binding PeakDiffSeries}"
                                                     XAxes="{Binding PeakDiffXAxes}"
                                                     YAxes="{Binding PeakDiffYAxes}"
                                                     Sections="{Binding PeakDiffSections}"
                                                     ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}"
                                                     TooltipTextSize="9" />
                                <!--
                                Zone captions as a fixed-fraction screen-space overlay, not
                                RectangularSection.Label: LiveChartsCore mispositions Label text
                                once more than one finite-Yi/Yj section shares an X window (each
                                caption rendered one zone-slot away from its own section - see
                                MainViewModel.Charts.cs's BuildThresholdZoneSections). Row heights
                                are the |dPeaks|<=15/<=30/>30 zone widths as fractions of the
                                fixed -80..80 Y range, so each caption centers in its own band
                                and stays there under zoom/pan (it's outside the chart's data
                                space entirely). Margin below is only the pre-data placeholder -
                                MainWindow.axaml.cs's OnPeakDiffChartLayoutUpdated overwrites it
                                with the chart's actual measured draw-margin rectangle on every
                                layout pass, since the real margin only exists once the axes have
                                real tick-label content (which depends on the loaded spectra) and
                                a value guessed before that is stale by construction.
                                -->
                                <Grid x:Name="PeakDiffZoneLabels" IsHitTestVisible="False" Margin="42,48,4,48"
                                      RowDefinitions="0.3125*,0.09375*,0.09375*,0.09375*,0.09375*,0.3125*">
                                    <TextBlock Grid.Row="0" Text="Broken Spectrum" Foreground="#DC3545" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="1" Text="Check PP" Foreground="#FFC107" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="2" Text="Safe range" Foreground="#DCDCDC" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="3" Text="Safe range" Foreground="#DCDCDC" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="4" Text="Check PP" Foreground="#FFC107" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Row="5" Text="Broken Spectrum" Foreground="#DC3545" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Probability Distribution" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="4,0">
                                <TextBlock Text="Decision Threshold:" VerticalAlignment="Center" FontSize="11" />
                                <Slider Width="160" Minimum="0" Maximum="1" TickFrequency="0.01"
                                        Value="{Binding ManualProbabilityThreshold}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ManualProbabilityThreshold, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <lvc:CartesianChart x:Name="ProbabilityChart"
                                                 Series="{Binding ProbabilitySeries}"
                                                 XAxes="{Binding ProbabilityXAxes}"
                                                 YAxes="{Binding ProbabilityYAxes}"
                                                 Sections="{Binding ProbabilitySections}"
                                                 ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}"
                                                 TooltipTextSize="9" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Classes="section">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Spectra Overlay" />
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="DodgerBlue" />
                                    <TextBlock Text="Reference" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Orange" />
                                    <TextBlock Text="Dataset" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Green" />
                                    <TextBlock Text="Actives" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Red" />
                                    <TextBlock Text="Inactives" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Button Content="Mark as Active" Command="{Binding MarkActiveCommand}" Classes="success" HorizontalAlignment="Stretch" />
                                <Button Content="Mark as Inactive" Command="{Binding MarkInactiveCommand}" Classes="danger" HorizontalAlignment="Stretch" />
                                <Button Content="Reset Flag Status" Command="{Binding ResetManualStatusCommand}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                            <Button Grid.Column="0" Content="Fit Zoom to Import Limits" Command="{Binding ResetOverlayZoomCommand}" />
                            <Button Grid.Column="2" Content="Fit Zoom to Reference" Command="{Binding FitOverlayZoomToReferenceCommand}" />
                        </Grid>
                        <lvc:CartesianChart Series="{Binding OverlaySeries}" XAxes="{Binding OverlayXAxes}" YAxes="{Binding OverlayYAxes}" ZoomMode="{x:Static lvcm:ZoomAndPanMode.Both}" TooltipTextSize="9" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottom bar: stats/results strip + experiment-navigation console -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*">

                <Grid Grid.Column="0" ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Analysis Info" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,2,0">
                                    <TextBlock Text="Reference" FontWeight="SemiBold" FontSize="9" />
                                    <TextBlock Text="{Binding ReferencePeakCount, StringFormat='Peaks: {0}'}" FontSize="9" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ReferenceMinIntensity, StringFormat='Min: {0:F0}'}" FontSize="9" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding ReferenceMaxIntensity, StringFormat='Max: {0:F0}'}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1" Margin="2,0,0,0">
                                    <TextBlock Text="Dataset" FontWeight="SemiBold" FontSize="9" />
                                    <TextBlock Text="{Binding DatasetAveragePeakCount, StringFormat='Avg Peaks: {0:F0}'}" FontSize="9" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DatasetAverageMinIntensity, StringFormat='Avg Min: {0:F0}'}" FontSize="9" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DatasetAverageMaxIntensity, StringFormat='Avg Max: {0:F0}'}" FontSize="9" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding DatasetSpectra.Count, StringFormat='#Exps: {0}'}" FontSize="9" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Automated Analysis Results" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <CheckBox Content="Actives" IsChecked="{Binding IsActivesFilterChecked}" />
                                <CheckBox Content="Inactives" IsChecked="{Binding IsInactivesFilterChecked}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*">
                                <Grid Grid.Column="0">
                                    <lvc:PieChart Series="{Binding ActivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}"
                                                  InitialRotation="180" MaxAngle="180" TooltipTextSize="9" />
                                    <Grid ColumnDefinitions="*,*" VerticalAlignment="Center" Margin="4,26,4,0" IsHitTestVisible="False">
                                        <TextBlock Grid.Column="0" Text="0" FontSize="9" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding DatasetSpectra.Count}" FontSize="9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding ActivesAutoCount}" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,38,0,0" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Grid.Column="1">
                                    <lvc:PieChart Series="{Binding InactivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}"
                                                  InitialRotation="180" MaxAngle="180" TooltipTextSize="9" />
                                    <Grid ColumnDefinitions="*,*" VerticalAlignment="Center" Margin="4,26,4,0" IsHitTestVisible="False">
                                        <TextBlock Grid.Column="0" Text="0" FontSize="9" HorizontalAlignment="Left" />
                                        <TextBlock Grid.Column="1" Text="{Binding DatasetSpectra.Count}" FontSize="9" HorizontalAlignment="Right" />
                                    </Grid>
                                    <TextBlock Text="{Binding InactivesAutoCount}" FontSize="18" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,38,0,0" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Manual Analysis Results" />
                            <Button DockPanel.Dock="Bottom" Content="Reset All Man. Flags" Command="{Binding ResetAllManualFlagsCommand}" Classes="compact" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            <lvc:CartesianChart Series="{Binding ManualResultsSeries}" XAxes="{Binding ManualResultsXAxes}" YAxes="{Binding ManualResultsYAxes}" TooltipTextSize="9" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Current Experiment:" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentExperimentNumber}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentCounterText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Go To Experiment:" VerticalAlignment="Center" />
                            <TextBox x:Name="GoToExperimentTextBox" Width="60" Text="{Binding GoToExperimentText}" />
                            <Button Content="Go" Command="{Binding GoToExperimentCommand}" Classes="accent" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Margin="4" Spacing="2">
                            <Grid ColumnDefinitions="*,*,*,*" VerticalAlignment="Top">
                                <Button Grid.Column="0" Command="{Binding FirstCommand}" Classes="player" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Image Source="avares://CspAnalyzer.Desktop/Assets/Player/first.png" Width="18" Height="18" />
                                        <TextBlock Text="First" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Command="{Binding PreviousCommand}" Classes="player" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Image Source="avares://CspAnalyzer.Desktop/Assets/Player/previous.png" Width="18" Height="18" />
                                        <TextBlock Text="Previous" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding NextCommand}" Classes="player" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Image Source="avares://CspAnalyzer.Desktop/Assets/Player/next.png" Width="18" Height="18" />
                                        <TextBlock Text="Next" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Command="{Binding LastCommand}" Classes="player" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                                        <Image Source="avares://CspAnalyzer.Desktop/Assets/Player/last.png" Width="18" Height="18" />
                                        <TextBlock Text="Last" FontSize="9" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding CurrentReadPeaks, StringFormat='Read Peaks: {0}'}" FontSize="10" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentMinIntensity, StringFormat='Min. Int.: {0:F0}'}" FontSize="10" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding CurrentMaxIntensity, StringFormat='Max. Int.: {0:F0}'}" FontSize="10" />
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CurrentPeakDifference, StringFormat='ΔPeaks: {0}'}" FontSize="10" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentAutomaticStatusText, StringFormat='Auto: {0}'}" FontSize="10" FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurrentManualStatusText, StringFormat='Man.: {0}'}" FontSize="10" Margin="0,2,0,0" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4" Spacing="2">
                            <Grid ColumnDefinitions="*,*">
                                <Button Grid.Column="0" Content="Ref PP Details" Command="{Binding ShowReferencePpDetailsCommand}" Classes="compact" HorizontalAlignment="Stretch" Margin="0,0,1,0" />
                                <Button Grid.Column="1" Content="Exp PP Details" Command="{Binding ShowExperimentPpDetailsCommand}" Classes="compact" HorizontalAlignment="Stretch" Margin="1,0,0,0" />
                            </Grid>
                            <Button Content="Export" Command="{Binding OpenResultsWindowCommand}" Classes="accent" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
