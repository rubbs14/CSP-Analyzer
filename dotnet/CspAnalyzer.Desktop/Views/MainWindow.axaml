<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CspAnalyzer.Desktop.ViewModels"
        xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
        xmlns:lvcm="using:LiveChartsCore.Measure"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1400" d:DesignHeight="820"
        x:Class="CspAnalyzer.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CSP Analyzer"
        Width="1400" Height="820" MinWidth="1000" MinHeight="650">

    <!--
    Layout shell from S7 (see the wireframe survey in docs/superpowers/
    SESSIONS.md history / session memory), with S8's dataset-loading
    bindings (File I/O buttons, import range/threshold, reference/dataset
    status), S9's run flow (Run CSP / Cancel, indeterminate progress bar -
    the python backend has no incremental progress protocol, so this is a
    single blocking-call spinner, not a percentage), and S10b's embedded
    charts + player navigation + manual-override workflow. The separate
    results table/pie-chart window (ResultsWindow) is S10.
    -->
    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Border.section">
            <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="4" />
        </Style>
        <Style Selector="TextBlock.sectionHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenShortcutsWindowCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+R" Command="{Binding ShowReferencePpDetailsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+E" Command="{Binding ShowExperimentPpDetailsCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding ResetOverlayZoomCommand}" />
        <KeyBinding Gesture="Ctrl+X" Command="{Binding FitOverlayZoomToReferenceCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+I" Command="{Binding ResetImportControlsCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+T" Command="{Binding ResetPeakFilteringCommand}" />
        <KeyBinding Gesture="Ctrl+Alt+O" Command="{Binding ResetAllImportAndThresholdControlsCommand}" />
    </Window.KeyBindings>
    <!--
    Bindings NOT declared above, added programmatically in the
    constructor instead:

    - Ctrl+Q (CloseCommand) and G (FocusGoToExperimentCommand): KeyBinding
      is a plain AvaloniaObject, not part of the visual/name-scope tree,
      so neither {Binding ..., RelativeSource={RelativeSource Self}} nor
      an ElementName/#name binding to a MainWindow-owned property
      resolves (both silently yield a null Command in Avalonia 11.2.3) -
      confirmed empirically, not assumed. Setting Command directly on a
      code-constructed KeyBinding sidesteps the binding system entirely.

    - R, N, D, S, A, T, and the arrow keys (Right/Left/Down/Up): these
      bare-key gestures collide with normal text entry and caret
      movement (e.g. typing "active" into GoToExperimentText types a
      bare "a"; pressing Right to move the caret in any focused
      TextBox). A plain {Binding XCommand} KeyBinding intercepts the key
      on KeyDown *before* the focused TextBox ever gets to insert the
      character or move the caret (confirmed empirically via
      KeyboardDevice.ProcessRawEvent: KeyBindings are matched by walking
      up from the focused element before the routed KeyDown event is
      even raised, so TextBox's own handling never runs once a binding's
      command reports CanExecute==true). Wrapping each in a command whose
      CanExecute additionally requires "no TextBox is currently focused"
      leaves CanExecute false while typing/editing, so the KeyBinding
      doesn't set Handled and the key falls through to the focused
      TextBox normally.
    -->

    <!-- Outer: fixed-width sidebar (Form1's tableLayoutPanel1, ~204px) + fill content (tableLayoutPanel2) -->
    <Grid ColumnDefinitions="210,*">

        <!-- Sidebar: panel1 / panel4 / panel3 / panel13 -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
            <Border Grid.Row="0" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="File I/O" />
                    <Button Content="Load Reference" Command="{Binding LoadReferenceCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
                    <Button Content="Load Dataset" Command="{Binding LoadDatasetCommand}" IsEnabled="{Binding IsReferenceLoaded}" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Classes="section">
                <StackPanel Spacing="1">
                    <TextBlock Classes="sectionHeader" Text="DS Info" />
                    <TextBlock Text="{Binding TotalSubfoldersFound, StringFormat='Exp Subfolders: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding ValidXmlPeaklistCount, StringFormat='Valid XML PeakList: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding CorruptedXmlPeaklistCount, StringFormat='Corrupted XML PeakList: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding OutOfPeakImportRangeCount, StringFormat='Out of Peak Import Range: {0}'}" FontSize="11" />
                    <TextBlock Text="{Binding ValidExperimentsCount, StringFormat='Valid Experiments: {0}'}" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Classes="section">
                <StackPanel Spacing="2">
                    <TextBlock Classes="sectionHeader" Text="Options" />

                    <TextBlock Text="Import Control" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="46,*" RowDefinitions="Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="NMin" VerticalAlignment="Center" />
                        <TextBox x:Name="NMinTextBox" Grid.Row="0" Grid.Column="1" Text="{Binding NMin}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="NMax" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NMax}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="HMin" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HMin}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="HMax" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding HMax}" />
                    </Grid>
                    <Button Content="Reset to Default" Command="{Binding ResetImportControlsCommand}" HorizontalAlignment="Stretch" Margin="0,2" />

                    <TextBlock Text="Peak Filtering" FontWeight="SemiBold" FontSize="11" Margin="0,4,0,0" />
                    <Grid ColumnDefinitions="62,*" RowDefinitions="Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Reference" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ReferenceIntensityThreshold}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Dataset" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DatasetIntensityThreshold}" />
                    </Grid>
                    <Button Content="Reset to Default" Command="{Binding ResetPeakFilteringCommand}" HorizontalAlignment="Stretch" Margin="0,2" />

                    <TextBlock Text="{Binding TotalSubfoldersFound, StringFormat='Subfolders scanned: {0}'}" FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding PeaklistFilesFoundCount, StringFormat='Peaklist files found: {0}'}" FontSize="11" />
                    <Button Content="Run CSP" Command="{Binding RunCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                    <Button Content="Cancel" Command="{Binding CancelRunCommand}" HorizontalAlignment="Stretch" Margin="0,2" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Classes="section">
                <StackPanel>
                    <TextBlock Classes="sectionHeader" Text="Run Info" />
                    <TextBlock Text="{Binding ReferenceStatusText}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DatasetStatusText}" TextWrapping="Wrap" />
                    <ProgressBar IsIndeterminate="{Binding IsRunning}" IsVisible="{Binding IsRunning}" Height="6" Margin="0,4" />
                    <Border IsVisible="{Binding RunCompletedSuccessfully}" Background="Green" CornerRadius="3" Margin="0,4" Padding="0,3">
                        <TextBlock Text="Analysis complete" Foreground="White" FontWeight="SemiBold" FontSize="11" HorizontalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding RunStatusText}" TextWrapping="Wrap" FontSize="11" />
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Classes="section">
                <StackPanel Spacing="4">
                    <Button Content="Save MCC Stats" HorizontalAlignment="Stretch" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Content="About" Command="{Binding OpenAboutWindowCommand}" />
                        <Button Content="Shortcuts" Command="{Binding OpenShortcutsWindowCommand}" />
                        <Button Content="Help" />
                    </StackPanel>
                    <TextBlock Text="Developed by R. Byrne and R. Fino" FontSize="9" FontStyle="Italic"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <Border Grid.Row="5" Classes="section">
                <StackPanel Spacing="4">
                    <TextBlock Classes="sectionHeader" Text="Appearance" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Content="Light" Click="OnThemeLightClick" />
                        <Button Content="Dark" Click="OnThemeDarkClick" />
                        <Button Content="System" Click="OnThemeSystemClick" />
                    </StackPanel>
                    <TextBlock Text="Background Color" FontSize="10" HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                        <Button Width="20" Height="20" Padding="0" Background="#1E1E2E" Click="OnBackgroundColorClick" Tag="#1E1E2E" />
                        <Button Width="20" Height="20" Padding="0" Background="#F5F5F5" Click="OnBackgroundColorClick" Tag="#F5F5F5" />
                        <Button Width="20" Height="20" Padding="0" Background="#1B2A38" Click="OnBackgroundColorClick" Tag="#1B2A38" />
                        <Button Width="20" Height="20" Padding="0" Background="#1F2E24" Click="OnBackgroundColorClick" Tag="#1F2E24" />
                        <Button Width="20" Height="20" Padding="0" Background="#2E1F2A" Click="OnBackgroundColorClick" Tag="#2E1F2A" />
                        <Button Content="Reset" FontSize="10" Click="OnBackgroundColorResetClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        </ScrollViewer>

        <!-- Content: chart zone (tableLayoutPanel3) + bottom bar (tableLayoutPanel6) -->
        <Grid Grid.Column="1" RowDefinitions="*,130">

            <!-- Chart zone: left stacked bar charts + right spectra overlay -->
            <Grid Grid.Row="0" ColumnDefinitions="*,*">
                <Grid Grid.Column="0" RowDefinitions="Auto,*,*">
                    <TextBlock Grid.Row="0" Text="MST Distance fingerprint" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" Margin="0,2,0,4" />
                    <Border Grid.Row="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Peaks Difference Distribution" />
                            <lvc:CartesianChart x:Name="PeakDiffChart"
                                                 Series="{Binding PeakDiffSeries}"
                                                 XAxes="{Binding PeakDiffXAxes}"
                                                 YAxes="{Binding PeakDiffYAxes}"
                                                 Sections="{Binding PeakDiffSections}"
                                                 VisualElements="{Binding PeakDiffAnnotations}"
                                                 ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Row="2" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Probability Distribution" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="4" Margin="4,0">
                                <TextBlock Text="Decision Threshold:" VerticalAlignment="Center" FontSize="11" />
                                <Slider Width="160" Minimum="0" Maximum="1" TickFrequency="0.01"
                                        Value="{Binding ManualProbabilityThreshold}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ManualProbabilityThreshold, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" FontSize="11" />
                            </StackPanel>
                            <lvc:CartesianChart x:Name="ProbabilityChart"
                                                 Series="{Binding ProbabilitySeries}"
                                                 XAxes="{Binding ProbabilityXAxes}"
                                                 YAxes="{Binding ProbabilityYAxes}"
                                                 Sections="{Binding ProbabilitySections}"
                                                 VisualElements="{Binding ProbabilityAnnotations}"
                                                 ZoomMode="{x:Static lvcm:ZoomAndPanMode.X}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Border Grid.Column="1" Classes="section">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Spectra Overlay" />
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,4">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="DodgerBlue" />
                                    <TextBlock Text="Reference" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Orange" />
                                    <TextBlock Text="Dataset" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Green" />
                                    <TextBlock Text="Actives" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <Ellipse Width="10" Height="10" Fill="Red" />
                                    <TextBlock Text="Inactives" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Button Content="Mark as Active" Command="{Binding MarkActiveCommand}" Background="LightGreen" HorizontalAlignment="Stretch" />
                                <Button Content="Mark as Inactive" Command="{Binding MarkInactiveCommand}" Background="LightPink" HorizontalAlignment="Stretch" />
                                <Button Content="Reset Flag Status" Command="{Binding ResetManualStatusCommand}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
                            <Button Grid.Column="0" Content="Fit Zoom to Import Limits" Command="{Binding ResetOverlayZoomCommand}" />
                            <Button Grid.Column="2" Content="Fit Zoom to Reference" Command="{Binding FitOverlayZoomToReferenceCommand}" />
                        </Grid>
                        <lvc:CartesianChart Series="{Binding OverlaySeries}" XAxes="{Binding OverlayXAxes}" YAxes="{Binding OverlayYAxes}" ZoomMode="{x:Static lvcm:ZoomAndPanMode.Both}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Bottom bar: stats/results strip + experiment-navigation console -->
            <Grid Grid.Row="1" ColumnDefinitions="*,*">

                <Grid Grid.Column="0" ColumnDefinitions="*,*,*">
                    <Border Grid.Column="0" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Analysis Info" />
                            <Grid ColumnDefinitions="*,*">
                                <StackPanel Grid.Column="0" Spacing="1">
                                    <TextBlock Text="Reference" FontWeight="SemiBold" FontSize="10" />
                                    <TextBlock Text="{Binding ReferencePeakCount, StringFormat='Read Peaks: {0}'}" FontSize="11" />
                                    <TextBlock Text="{Binding ReferenceMinIntensity, StringFormat='Min. Int.: {0:F0}'}" FontSize="11" />
                                    <TextBlock Text="{Binding ReferenceMaxIntensity, StringFormat='Max Int.: {0:F0}'}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="Dataset" FontWeight="SemiBold" FontSize="10" />
                                    <TextBlock Text="{Binding DatasetAveragePeakCount, StringFormat='Avg Peak Count: {0:F0}'}" FontSize="11" />
                                    <TextBlock Text="{Binding DatasetAverageMinIntensity, StringFormat='Avg Min. Int.: {0:F0}'}" FontSize="11" />
                                    <TextBlock Text="{Binding DatasetAverageMaxIntensity, StringFormat='Avg Max Int.: {0:F0}'}" FontSize="11" />
                                    <TextBlock Text="{Binding DatasetSpectra.Count, StringFormat='#Exps: {0}'}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Automated Analysis Results" />
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                                <CheckBox Content="Actives" IsChecked="{Binding IsActivesFilterChecked}" />
                                <CheckBox Content="Inactives" IsChecked="{Binding IsInactivesFilterChecked}" />
                            </StackPanel>
                            <Grid ColumnDefinitions="*,*">
                                <Grid Grid.Column="0">
                                    <lvc:PieChart Series="{Binding ActivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}" />
                                    <TextBlock Text="{Binding ActivesAutoCount}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <Grid Grid.Column="1">
                                    <lvc:PieChart Series="{Binding InactivesGaugeSeries}" MaxValue="{Binding DatasetSpectra.Count}" />
                                    <TextBlock Text="{Binding InactivesAutoCount}" FontSize="20" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Classes="section">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Classes="sectionHeader" Text="Manual Analysis Results" />
                            <Button DockPanel.Dock="Bottom" Content="Reset All Man. Flags" Command="{Binding ResetAllManualFlagsCommand}" HorizontalAlignment="Stretch" Margin="0,4,0,0" />
                            <lvc:CartesianChart Series="{Binding ManualResultsSeries}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Column="1" RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Current Experiment:" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentExperimentNumber}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CurrentCounterText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="4" Spacing="4">
                            <TextBlock Text="Go To Experiment:" VerticalAlignment="Center" />
                            <TextBox x:Name="GoToExperimentTextBox" Width="60" Text="{Binding GoToExperimentText}" />
                            <Button Content="Go" Command="{Binding GoToExperimentCommand}" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
                        <Grid Grid.Column="0" ColumnDefinitions="*,*,*,*" Margin="4" VerticalAlignment="Top">
                            <Button Grid.Column="0" Content="|&lt;" Command="{Binding FirstCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="1" Content="&lt;" Command="{Binding PreviousCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="2" Content="&gt;" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" />
                            <Button Grid.Column="3" Content="&gt;|" Command="{Binding LastCommand}" HorizontalAlignment="Stretch" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="4" Spacing="2">
                            <TextBlock Text="{Binding CurrentReadPeaks, StringFormat='Read Peaks: {0}'}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentMinIntensity, StringFormat='Min. Int.: {0:F0}'}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentMaxIntensity, StringFormat='Max. Int.: {0:F0}'}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentPeakDifference, StringFormat='ΔPeaks: {0}'}" FontSize="10" />
                            <TextBlock Text="{Binding CurrentAutomaticStatusText, StringFormat='Auto Status: {0}'}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding CurrentManualStatusText, StringFormat='Man. Status: {0}'}" FontSize="10" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4" Spacing="2">
                            <Button Content="Ref PP Details" Command="{Binding ShowReferencePpDetailsCommand}" HorizontalAlignment="Stretch" FontSize="10" />
                            <Button Content="Exp PP Details" Command="{Binding ShowExperimentPpDetailsCommand}" HorizontalAlignment="Stretch" FontSize="10" />
                            <Button Content="Export" Command="{Binding OpenResultsWindowCommand}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
